# Enforce node version specified in package.json
engine-strict=true

# Pin versions exactly to avoid "it works on my machine" issues
save-exact=true

# Reduce noise in terminal
fund=false
update-notifier=false

# pnpm specific settings
# Ensure lockfile is strictly followed in CI
frozen-lockfile=true

# Refuse to resolve package versions published less than 7 days ago.
# Fast-burn supply-chain compromises are typically detected and unpublished within this window.
# (Supported by npm >= 11.10.0)
min-release-age=7
