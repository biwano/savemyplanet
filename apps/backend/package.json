{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsup src/index.ts --format esm --target node22 --out-dir dist --clean --sourcemap",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=../../.env ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file-if-exists=../../.env ./node_modules/vitest/vitest.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "klima:discover": "tsx --env-file=../../.env scripts/klima-discover-quote.ts"
  },
  "dependencies": {
    "@clerk/backend": "latest",
    "@hono/node-server": "latest",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "hono": "latest",
    "stripe": "22.6.1",
    "viem": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.0.0",
    "drizzle-kit": "latest",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "tsup": "8.5.1",
    "tsx": "latest",
    "typescript": "^5.5.4",
    "typescript-eslint": "8.69.0",
    "vitest": "3.2.7"
  }
}
