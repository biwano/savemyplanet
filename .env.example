# Database (Neon) — pooled (`-pooler` in host) or direct both work for the app.
# Prefer pooled for Cloud Run; use a direct (non-pooler) URL for `db:migrate`.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# HTTP
# Comma-separated allowlist in production. Use * only for local dev (default when unset and NODE_ENV≠production).
CORS_ORIGINS=*
PORT=3000

# Auth (Clerk)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# From Clerk Dashboard → Webhooks → endpoint signing secret (whsec_…)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# Expo client (apps/mobile/.env): EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY = same pk_test_…
# and EXPO_PUBLIC_API_URL = staging Cloud Run URL — see apps/mobile/.env.example

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Admin (manual USD credit via POST /account/credit)
ADMIN_API_KEY=dev-admin-key-change-me

# Klima x402 (read: discover/quote; write: retire needs payer key unless fake)
KLIMA_BASE_URL=https://x402.klimalabs.com
# Optional: 8453 Base mainnet (default) or 84532 Sepolia
# KLIMA_CHAIN_ID=8453
# In-process discover catalog cache (ms). Default 60000; 0 disables. Live /quote is never cached.
# KLIMA_DISCOVER_CACHE_TTL_MS=60000
KLIMA_PAYER_PRIVATE_KEY=0x...
# Optional: Base mainnet JSON-RPC for live USDC balanceOf (C1 headroom).
# Default https://mainnet.base.org is fine for demos; prefer a dedicated
# Alchemy/Infura (or similar) URL in production via KLIMA_RPC_URL.
# KLIMA_RPC_URL=https://mainnet.base.org
# Optional: pad on quote klima_total when claiming headroom before auth (bps). Default 1000 = 10%
# KLIMA_HEADROOM_PAD_BPS=1000
# Staging only: fake = synthetic retire (no USDC). Unset / real = live x402.
# Forbidden on production Cloud Run service savemyplanet-api (boot fails).
# KLIMA_RETIRE_MODE=fake
# Optional fake outcomes: pending_index (default) | settled | fail
# KLIMA_FAKE_RETIRE_STATUS=pending_index

# Pricing (POST /quotes). Markup is applied over Klima wholesale; round up to cents.
# MARKUP_BPS=4000
# Optional discover price cap when auto-picking a carbon class (USDC/t)
# KLIMA_MAX_USDC_PRICE_PER_TONNE=50
# Quote TTL in ms (default 600000 = 10 minutes)
# QUOTE_TTL_MS=600000

# LLM via OpenRouter (OpenAI-compatible). Required for POST /evaluations.
OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
