# Database (Neon) — pooled (`-pooler` in host) or direct both work for the app.
# Prefer pooled for Cloud Run; use a direct (non-pooler) URL for `db:migrate`.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# HTTP
# Comma-separated allowlist in production. Use * only for local dev (default when unset and NODE_ENV≠production).
CORS_ORIGINS=*
PORT=3000

# Auth (Clerk)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# From Clerk Dashboard → Webhooks → endpoint signing secret (whsec_…)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Admin (manual USD credit via POST /account/credit)
ADMIN_API_KEY=dev-admin-key-change-me

# Klima x402 (read: discover/quote; write: retire needs payer key)
KLIMA_BASE_URL=https://x402.klimalabs.com
# Optional: 8453 Base mainnet (default) or 84532 Sepolia
# KLIMA_CHAIN_ID=8453
# In-process discover catalog cache (ms). Default 60000; 0 disables. Live /quote is never cached.
# KLIMA_DISCOVER_CACHE_TTL_MS=60000
KLIMA_PAYER_PRIVATE_KEY=0x...

# Pricing (POST /quotes). Markup is applied over Klima wholesale; round up to cents.
# MARKUP_BPS=4000
# Optional discover price cap when auto-picking a carbon class (USDC/t)
# KLIMA_MAX_USDC_PRICE_PER_TONNE=50
# Quote TTL in ms (default 600000 = 10 minutes)
# QUOTE_TTL_MS=600000

# LLM (OpenAI/Gemini)
OPENAI_API_KEY=sk-...
# or
GEMINI_API_KEY=...
